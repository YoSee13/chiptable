rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /games/{gameId} {
      // Anyone signed in with Google who has the game link can watch it.
      allow read: if request.auth != null;
      // Only the host creates, edits and deletes the game.
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == request.auth.uid)
        // a viewer may only add themselves to `viewers`, so the game shows up in their history
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
            && request.resource.data.viewers.hasAll(resource.data.viewers)
            && request.resource.data.viewers.size() == resource.data.viewers.size() + 1
            && request.auth.uid in request.resource.data.viewers)
      );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // חצי־חצי (split/): shared expense groups. `uids` lists the Google accounts that joined the group.
    match /splitGroups/{groupId} {
      // The document id is the invite secret: whoever has the link (and is signed in) can open the group...
      allow get: if request.auth != null;
      // ...but listing only ever returns groups the user already joined.
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.uids;
      allow update: if request.auth != null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // members edit expenses, members' names and their own membership
          request.auth.uid in resource.data.uids
          // someone with the invite link may only add themselves to `uids`
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
              && request.resource.data.uids.hasAll(resource.data.uids)
              && request.resource.data.uids.size() == resource.data.uids.size() + 1
              && request.auth.uid in request.resource.data.uids)
        );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
